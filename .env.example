# Copy to .env and fill in. .env is gitignored.

# Notion integration token (required for export-notion).
# Create at https://www.notion.so/profile/integrations
NOTION_TOKEN=

# Google Maps Platform key (required for commute enrichment, ADR-010).
# Enable: Geocoding API, Routes API, Elevation API.
# Cap usage with MAPS_DAILY_BUDGET_USD below.
GOOGLE_MAPS_API_KEY=

# Anthropic API key (required only if enrichment.llm: true in filters.yaml; ADR-009).
ANTHROPIC_API_KEY=

# Daily spend caps (optional; defaults shown).
MAPS_DAILY_BUDGET_USD=5.00
LLM_DAILY_BUDGET_USD=1.00

# Set to 1 to run Playwright headed for debugging (ADR-002).
HEADED=
